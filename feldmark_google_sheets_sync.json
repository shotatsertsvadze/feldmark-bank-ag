    {
      "id": "9668b272-71b6-4b74-9d93-89f1a397c670",
      "name": "Pfändungsfälle laden (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        420,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.fall_id,\n       f.aktenzeichen,\n       f.glaeubiger,\n       f.schuldner,\n       to_char(f.zustelldatum, 'YYYY-MM-DD') AS zustelldatum,\n       f.zustellkanal,\n       f.dokumenttyp,\n       f.status,\n       e.forderung_gesamt_eur,\n       e.guthaben_eur,\n       e.ist_p_konto,\n       e.ist_gemeinschaftskonto,\n       letztes.ereignis AS letztes_ereignis,\n       to_char(letztes.erzeugt_am, 'YYYY-MM-DD HH24:MI') AS letztes_ereignis_am\nFROM   feldmark.pfaendung_faelle f\nLEFT JOIN feldmark.pfaendung_erweiterung e ON e.fall_id = f.fall_id\nLEFT JOIN LATERAL (\n  SELECT ereignis, erzeugt_am\n  FROM   feldmark.pfaendung_protokoll p\n  WHERE  p.fall_id = f.fall_id\n  ORDER  BY p.erzeugt_am DESC\n  LIMIT  1\n) letztes ON true\nORDER BY f.zustelldatum DESC;",
        "options": {}
      }
    },
