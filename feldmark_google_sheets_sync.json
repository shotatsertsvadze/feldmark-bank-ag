        "query": "SELECT f.fall_id,\n       f.aktenzeichen,\n       f.ausstellende_behoerde,\n       f.betroffene_person_name,\n       to_char(f.eingangsdatum, 'YYYY-MM-DD') AS eingangsdatum,\n       f.antwortfrist_tage,\n       f.zustellkanal,\n       f.status,\n       f.vertraulich,\n       letztes.ereignis AS letztes_ereignis,\n       to_char(letztes.erzeugt_am, 'YYYY-MM-DD HH24:MI') AS letztes_ereignis_am\nFROM   feldmark.auskunftsersuchen_faelle f\nLEFT JOIN LATERAL (\n  SELECT ereignis, erzeugt_am\n  FROM   feldmark.auskunftsersuchen_protokoll p\n  WHERE  p.fall_id = f.fall_id\n  ORDER  BY p.erzeugt_am DESC\n  LIMIT  1\n) letztes ON true\nORDER BY f.eingangsdatum DESC;",
