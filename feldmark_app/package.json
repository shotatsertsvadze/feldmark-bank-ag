{
  "name": "feldmark_app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Feldmark Bank AG - digitale Plattform. Erstes Feature: Klassifikation und Extraktion eingehender Schreiben ueber die Mistral OCR- und Chat-API, mit Fallanlage in Postgres.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5191",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "heic-convert": "^2.1.0",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.6"
  }
}
