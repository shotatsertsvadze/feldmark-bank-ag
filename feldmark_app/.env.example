# Keine Secrets hier eintragen - diese Datei ist nur Dokumentation und wird
# committet. Reale Werte gehoeren ausschliesslich in .env (gitignored).

# Port des lokalen API-Servers (Standard 4300)
FELDMARK_KLASSIFIKATION_SERVER_PORT=4300

# Mistral-API-Key fuer OCR (/v1/ocr) und Klassifikation/Extraktion
# (/v1/chat/completions). Anzulegen unter console.mistral.ai -> API Keys.
MISTRAL_API_KEY=

# Modell fuer Klassifikation + Feld-Extraktion aus dem OCR-Rohtext.
# Optional, Standard mistral-small-latest.
MISTRAL_EXTRAKTIONS_MODELL=mistral-small-latest

# Timeout pro Mistral-Aufruf in Millisekunden (Standard 60000). Nach einem
# Timeout oder einem 429/5xx wird genau einmal wiederholt.
MISTRAL_TIMEOUT_MS=60000

# Pause vor dem einen Wiederholungsversuch in Millisekunden (Standard 1500).
MISTRAL_RETRY_PAUSE_MS=1500

# Postgres-Connection-String zum Supabase-Projekt - dieselben Tabellen, die
# auch die n8n-Workflows nutzen. Alle Tabellen liegen im Schema "feldmark".
#
# WICHTIG: den Session-Pooler nehmen, nicht die direkte Verbindung. Zu finden
# in Supabase: Project Settings -> Database -> Connection string -> Session
# pooler. Die direkte Verbindung (db.<ref>.supabase.co) laeuft nur ueber IPv6;
# der n8n-Host hat aber nur IPv4, und App und n8n sollen denselben Pfad
# nutzen. Benutzername ist beim Pooler "postgres.<project-ref>", nicht
# "postgres". Passwort dort einsetzen, nicht hier committen.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORT]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
