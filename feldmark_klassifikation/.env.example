# Keine Secrets hier eintragen - diese Datei ist nur Dokumentation und wird
# committet. Reale Werte gehoeren ausschliesslich in .env (gitignored).

# Port des lokalen API-Servers (Standard 4300)
FELDMARK_KLASSIFIKATION_SERVER_PORT=4300

# Mistral-API-Key fuer OCR (/v1/ocr) und Klassifikation/Extraktion
# (/v1/chat/completions). Derselbe Key wie in belegerkennung/.env.
MISTRAL_API_KEY=

# Modell fuer Klassifikation + Feld-Extraktion aus dem OCR-Rohtext.
# Optional, Standard mistral-small-latest.
MISTRAL_EXTRAKTIONS_MODELL=mistral-small-latest

# Postgres-Connection-String zum Supabase-Projekt "shotatsertsvadze's Project"
# (ziwzymarlakoxrgdesvw) - dieselben Tabellen, die auch der n8n-Workflow
# feldmark_fristueberwachung_postgres.json nutzt.
# Zu finden in Supabase: Project Settings -> Database -> Connection string
# -> URI (Node.js-Format). Passwort dort einsetzen, nicht hier committen.
DATABASE_URL=postgresql://postgres:[DB-PASSWORT]@db.ziwzymarlakoxrgdesvw.supabase.co:5432/postgres
